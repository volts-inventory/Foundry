# Keep the build context small + deterministic (no host state, no secrets).
.git
.gitignore
.github
.claude

# Python caches / build artifacts
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Test / type / coverage caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.hypothesis/
mutants/

# Local durable state must NEVER enter the image (it lives on volumes)
var/
*.sqlite
*.sqlite-*

# Docs/infra not needed at runtime
docs/
*.md
docker-compose.yml
Dockerfile
.dockerignore

# Editor / OS noise
.idea/
.vscode/
.DS_Store
