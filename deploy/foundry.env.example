# =====================================================================
#  Foundry Workshop — server environment (copy to `foundry.env`, edit)
# =====================================================================
# Every value below is read by webapp/server.py at startup. Lines are
# `KEY=value`; both the systemd unit (Pi) and the launchd wrapper (Mac)
# load this file. Values marked [Pi] / [Mac] note a host-specific default.

# ---- bind address -----------------------------------------------------
# 0.0.0.0 exposes the server on your LAN (e.g. reach the Pi from a laptop).
# If you bind beyond localhost you MUST set a token below.
WORKSHOP_HOST=0.0.0.0
WORKSHOP_PORT=8765
# Shared secret required for state-changing routes when not localhost-only.
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
FOUNDRY_WORKSHOP_TOKEN=change-me

# ---- durable state (MUST survive a reboot) ----------------------------
# On a Pi keep these on the SD/SSD (NOT tmpfs). On a Mac, anywhere on the
# internal SSD is fine. The build's checkpoints + content store live here;
# this is what lets a build resume after a restart.
WORKSHOP_OUTPUT_DIR=/var/lib/foundry/out
FOUNDRY_STATE_DIR=/var/lib/foundry/state

# ---- build scratch -> RAM (tmpfs) -------------------------------------
# [Pi] Point the heavy, churny gate/test scratch (node_modules, build
# output) at a size-capped tmpfs so it never wears the SD card. See
# pi/tmpfs.fstab.snippet. [Mac] leave unset — the SSD handles it fine.
TMPDIR=/var/foundry-tmp

# ---- model backend (this host ORCHESTRATES; the MODEL runs remote) -----
# anthropic | openai | claude-cli | codex | mock | ollama-gemma
# A complex multi-day build wants a hosted API (NOT local ollama on a Pi).
FOUNDRY_MODEL_BACKEND=anthropic
FOUNDRY_CODING_ADAPTER=raw-react        # raw-react = real code; stub = smoke
# Provider credential — set the one your backend needs:
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ---- cost ceiling (hard stop, metered API backends) -------------------
# Micro-USD. Blank = no cap. Example: 50000000 = $50.
FOUNDRY_COST_CAP_MICROUSD=

# ---- host-safety: cap concurrent HEAVY builds -------------------------
# Each build runs model calls + local gate subprocesses. Two big builds at
# once can exhaust RAM. [Pi] 1.  [Mac M-series/24GB] 3-4.  0 = unlimited.
WORKSHOP_MAX_CONCURRENT_BUILDS=1

# ---- per-build internal parallelism -----------------------------------
# Tasks within a single service. [Pi] 2.  [Mac] 4-6.
FOUNDRY_MAX_SLOTS=2

# ---- provider throttling (ride out rate limits over a long run) -------
# Stay under your plan's limits. 0 = off.
FOUNDRY_MAX_RPM=0                        # requests/min cap (paced)
FOUNDRY_MAX_CONCURRENT_CALLS=0           # simultaneous model calls cap
FOUNDRY_RATE_LIMIT_RETRIES=6             # waits to absorb a 429/529 burst

# ---- long-run credential refresh --------------------------------------
# Rebuild the SDK client every N seconds so an expired/rotated token is
# picked up without a restart. 0 = off; 3600 = hourly (recommended).
FOUNDRY_CLIENT_TTL_S=3600

# ---- gate test sandbox ------------------------------------------------
# Generated tests run in a Linux namespace sandbox (no network) by DEFAULT.
# [Mac] macOS has no `unshare`, so the gate FAILS CLOSED unless you opt out to
# the in-process harness (sys.path-fenced, but NO network isolation):
#   on macOS set:  FOUNDRY_GATE_SANDBOX=inprocess
# [Pi/Linux] leave UNSET to keep the real sandbox. Prefer Linux for untrusted builds.
# FOUNDRY_GATE_SANDBOX=inprocess
