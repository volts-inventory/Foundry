# =====================================================================
#  Foundry Workshop — macOS laptop preset (Apple-silicon)
# =====================================================================
# Ready-to-run values for a Mac. Copy it and paste your API key — that's the
# only required edit:
#     cp deploy/foundry.mac.env.example deploy/foundry.env
#     # set ANTHROPIC_API_KEY below, then:  ./deploy/run.sh
# (Loaded by deploy/run.sh / the launchd wrapper, which expand $HOME.)
# See foundry.env.example for the fully-annotated reference.

# ---- bind address (localhost only — just this Mac) --------------------
WORKSHOP_HOST=127.0.0.1
WORKSHOP_PORT=8765
# No token needed for localhost-only. (Set one if you switch HOST to 0.0.0.0.)
# FOUNDRY_WORKSHOP_TOKEN=change-me

# ---- durable state (survives restarts; resumes builds) ----------------
WORKSHOP_OUTPUT_DIR=$HOME/foundry/out
FOUNDRY_STATE_DIR=$HOME/foundry/state
# (No TMPDIR override — the Mac's SSD handles build scratch fine.)

# ---- model engine + credential ----------------------------------------
FOUNDRY_MODEL_BACKEND=anthropic         # anthropic | openai | claude-cli | codex | mock
FOUNDRY_CODING_ADAPTER=raw-react        # leave as-is (writes real code)
ANTHROPIC_API_KEY=                      # <-- PASTE YOUR KEY HERE
# OPENAI_API_KEY=                       # (instead, if you set backend to openai/codex)

# ---- cost ceiling (hard stop) -----------------------------------------
FOUNDRY_COST_CAP_MICROUSD=50000000      # $50; raise/lower or blank for no cap

# ---- sizing for a 24 GB Mac -------------------------------------------
WORKSHOP_MAX_CONCURRENT_BUILDS=3        # builds at once (extras queue)
FOUNDRY_MAX_SLOTS=4                     # tasks within a build

# ---- gate test sandbox: REQUIRED on macOS -----------------------------
# macOS has no Linux namespace sandbox, so without this EVERY build halts at the
# test gate. This runs generated tests sys.path-fenced — but WITHOUT network
# isolation (they run in your user env). Fine for your own builds; for untrusted
# ones prefer a Linux host (the Pi).
FOUNDRY_GATE_SANDBOX=inprocess

# ---- long-run hardening (safe defaults) -------------------------------
FOUNDRY_CLIENT_TTL_S=3600               # refresh the SDK client hourly
FOUNDRY_MAX_RPM=0                       # set to your plan's req/min only if you hit limits
FOUNDRY_RATE_LIMIT_RETRIES=6            # waits to ride out a 429/529 burst
