# =====================================================================
#  Foundry Workshop — Raspberry Pi (8 GB) / Linux preset
# =====================================================================
# Ready-to-run values for a Pi or any systemd Linux host. Edit the token + API
# key, then install per deploy/README.md:
#     sudo cp deploy/foundry.pi.env.example /etc/foundry/foundry.env
#     sudo nano /etc/foundry/foundry.env        # set token + key
# Absolute paths only (systemd EnvironmentFile does NOT expand $HOME or ~).
# See foundry.env.example for the fully-annotated reference.

# ---- bind address (exposed on the LAN — token REQUIRED) ---------------
WORKSHOP_HOST=0.0.0.0
WORKSHOP_PORT=8765
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(24))"
FOUNDRY_WORKSHOP_TOKEN=change-me        # <-- REQUIRED (server is on your network)

# ---- durable state (keep on the SD/SSD, NOT tmpfs) --------------------
WORKSHOP_OUTPUT_DIR=/var/lib/foundry/out
FOUNDRY_STATE_DIR=/var/lib/foundry/state

# ---- build scratch -> RAM (tmpfs; protects the SD card) ---------------
# Requires the tmpfs mount from deploy/pi/tmpfs.fstab.snippet.
TMPDIR=/var/foundry-tmp

# ---- model engine + credential ----------------------------------------
FOUNDRY_MODEL_BACKEND=anthropic         # hosted API (the Pi can't run a big local model)
FOUNDRY_CODING_ADAPTER=raw-react        # leave as-is (writes real code)
ANTHROPIC_API_KEY=                      # <-- PASTE YOUR KEY HERE
# OPENAI_API_KEY=                       # (instead, if you set backend to openai/codex)

# ---- cost ceiling (hard stop) -----------------------------------------
FOUNDRY_COST_CAP_MICROUSD=50000000      # $50; raise/lower or blank for no cap

# ---- sizing for an 8 GB Pi (keep it modest) ---------------------------
WORKSHOP_MAX_CONCURRENT_BUILDS=1        # one heavy build at a time (extras queue)
FOUNDRY_MAX_SLOTS=2                     # tasks within a build

# ---- gate test sandbox: keep the real Linux sandbox -------------------
# Leave FOUNDRY_GATE_SANDBOX UNSET so generated tests run in the unprivileged
# namespace sandbox (no network). Do NOT set inprocess on a shared/exposed host.

# ---- long-run hardening (safe defaults) -------------------------------
FOUNDRY_CLIENT_TTL_S=3600               # refresh the SDK client hourly
FOUNDRY_MAX_RPM=0                       # set to your plan's req/min only if you hit limits
FOUNDRY_RATE_LIMIT_RETRIES=6            # waits to ride out a 429/529 burst

# ---- (optional) backup destination for deploy/pi/backup.sh ------------
# FOUNDRY_BACKUP_SRC=/var/lib/foundry
# FOUNDRY_BACKUP_DST=/mnt/backup/foundry
