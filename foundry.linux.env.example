# =====================================================================
#  Foundry Workshop — Linux preset (incl. Raspberry Pi, 8 GB)
# =====================================================================
# Ready-to-run values for a Pi or any Linux host. Auth for claude-cli two ways (pick
# one): log in on this machine (`claude /login`), or mint a token and store it in .env
# (`claude setup-token`) — on a headless box the token is usually easiest:
#     cp foundry.linux.env.example .env
#     $EDITOR .env                      # set the credential (see "model engine" below)
#     python -m webapp.server    # → http://localhost:8765 (loads .env on startup)
# Durable paths default to $HOME/foundry so it runs WITHOUT root; see the note below
# to switch to /var/lib for a system-service deploy.

# ---- bind address (0.0.0.0 = reachable on your LAN, e.g. from a phone) -
WORKSHOP_HOST=0.0.0.0
WORKSHOP_PORT=8765
# Shared token for state-changing routes — OPTIONAL. Unset (leave commented) = no
# token: fine on a TRUSTED home LAN (same-origin requests still pass the CSRF guard).
# RECOMMENDED on a SHARED/public network, so only you can start builds. To enable,
# uncomment and set one — generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
#   …then open the UI at  http://<pi-ip>:8765/?token=<that-value>
# FOUNDRY_WORKSHOP_TOKEN=change-me

# ---- durable state (keep on the SD/SSD, NOT tmpfs) --------------------
# Defaults to your home dir so it works WITHOUT root. For a system-service
# deploy running as a dedicated user, switch these to /var/lib/foundry/{out,state}
# and provision once:  sudo mkdir -p /var/lib/foundry && sudo chown -R "$USER" /var/lib/foundry
WORKSHOP_OUTPUT_DIR=$HOME/foundry/out
FOUNDRY_STATE_DIR=$HOME/foundry/state

# ---- build scratch -> RAM (tmpfs; protects an SD card from churn) -----
# On a Pi, mount a size-capped tmpfs and point TMPDIR at it, e.g. in /etc/fstab:
#   tmpfs  /var/foundry-tmp  tmpfs  size=3G,mode=1777,noatime  0  0
TMPDIR=/var/foundry-tmp

# ---- model engine + credential ----------------------------------------
# Claude Code (`claude -p`) — runs on your Max subscription, no API key/billing.
# Needs the `claude` CLI installed (arm64 on a Pi). Auth two ways (pick one): log in
# on this machine (`claude /login` — session cached on disk, auto-refreshes, leave the
# token blank), OR mint a token (`claude setup-token`) and paste it below. On a headless
# box the token is usually easiest. Already logged in? Leave it blank.
FOUNDRY_MODEL_BACKEND=claude-cli        # claude-cli | anthropic | openai | codex
FOUNDRY_CODING_ADAPTER=claude-code      # AGENTIC: claude edits/builds/tests in the task
                                        # sandbox (multi-turn). Alternatives: raw-react
                                        # (one completion -> one diff) | stub (no-op)
CLAUDE_CODE_OAUTH_TOKEN=                # optional — PASTE `claude setup-token` OUTPUT, or leave blank if logged in
# Prefer the metered API? Comment the token, set backend=anthropic, and use:
#   ANTHROPIC_API_KEY=sk-ant-...

# ---- model per tier (current Anthropic Claude models, via claude -p) ---
# The factory picks a tier per task; pin the exact model id each maps to.
FOUNDRY_MODEL_T1=claude-opus-4-8        # heaviest reasoning
FOUNDRY_MODEL_T2=claude-sonnet-4-6      # mid / default
FOUNDRY_MODEL_T3=claude-haiku-4-5       # light / cheap

# ---- token efficiency (stretch a Max window further) ------------------
# All optional; apply to BOTH the CLI and the Workshop (env is read the same way).
# Especially worth it on a Pi, where quota is precious. Trade-offs noted:
#   Recover prompt caching on claude-cli: routes the stable per-role SOP through
#   `claude --append-system-prompt` so repeated prefixes (esp. fix-loop retries)
#   hit Anthropic's cache. Verify via the REPO manifest's cache-read tokens.
# FOUNDRY_CLI_CACHE_SYSTEM=1
#   Recurring review/judge calls on Sonnet instead of Opus (biggest saving; set
#   T1 to restore Opus).
# FOUNDRY_REVIEW_TIER=T2
#   Security-review floor (appsec + supply-chain) on Sonnet — fine for a hobby
#   build; leave UNSET (T1) for anything security-sensitive.
# FOUNDRY_SECURITY_TIER=T2

# ---- cost ceiling (only applies to metered API backends) --------------
# Ignored for claude-cli (subscription). Set it if you switch to anthropic/openai.
# FOUNDRY_COST_CAP_MICROUSD=50000000    # $50

# ---- sizing for an 8 GB Pi (keep it modest) ---------------------------
WORKSHOP_MAX_CONCURRENT_BUILDS=1        # one heavy build at a time (extras queue)
FOUNDRY_MAX_SLOTS=2                     # tasks within a build

# ---- gate test sandbox: keep the real Linux sandbox -------------------
# Leave FOUNDRY_GATE_SANDBOX UNSET so generated tests run in the unprivileged
# namespace sandbox (no network). Do NOT set inprocess on a shared/exposed host.

# ---- long-run hardening (safe defaults) -------------------------------
FOUNDRY_CLIENT_TTL_S=3600               # refresh the SDK client hourly
FOUNDRY_MAX_RPM=0                       # set to your plan's req/min only if you hit limits
FOUNDRY_RATE_LIMIT_RETRIES=6            # waits to ride out a 429/529 burst
FOUNDRY_RATE_LIMIT_MAX_WAIT_S=21600     # cap for ONE wait-until-reset (6h) — a spent
                                        # Max window is slept through, not crashed

# ---- (optional) back up the durable state so a dead card = restore+resume ----
# e.g. a cron job:  rsync -a --delete "$HOME/foundry/" /mnt/backup/foundry/
