# =====================================================================
#  Foundry Workshop — macOS laptop preset (Apple-silicon)
# =====================================================================
# Ready-to-run values for a Mac. Defaults to Claude Code (`claude -p`, a Max plan —
# no per-token API billing). Auth two ways (pick one) — skip both if you're already
# logged in here: log in on this machine, or mint a token and paste it below:
#     cp foundry.mac.env.example .env
#     claude /login                     # a) log in here — session on disk, auto-refreshes
#     # claude setup-token              # b) or mint a token → paste as CLAUDE_CODE_OAUTH_TOKEN below
#     python -m webapp.server           # → http://localhost:8765
# (The server loads .env on startup. For a long run on a Mac that mustn't sleep,
#  prefix with caffeinate:  caffeinate -is python -m webapp.server)

# ---- bind address (localhost only — just this Mac) --------------------
WORKSHOP_HOST=127.0.0.1
WORKSHOP_PORT=8765
# No token needed for localhost-only. (Set one if you switch HOST to 0.0.0.0.)
# FOUNDRY_WORKSHOP_TOKEN=change-me

# ---- sign-in ------------------------------------------------------------
# The Workshop asks for a username and password. It is seeded as
# admin / changeme on first boot and makes you replace that before any build
# can start; the hash lives beside the durable state below, never here.
#
# These two only SEED the account, on the very first boot. After that the
# password is in that state directory and editing them does nothing — change it
# in the UI instead.
# FOUNDRY_ADMIN_USERNAME=admin
# FOUNDRY_AUTH_PASSWORD=pick-something-long
#
# Mark the session cookie Secure. Only behind HTTPS — over plain HTTP a Secure
# cookie is never sent back and you could never sign in.
# FOUNDRY_COOKIE_SECURE=false
#
# Turn the login OFF entirely. Reasonable for a localhost-only run where it is
# just friction; not on anything another machine can reach, because what is
# behind it spends money and runs generated code.
# FOUNDRY_AUTH=off

# ---- durable state (survives restarts; resumes builds) ----------------
WORKSHOP_OUTPUT_DIR=$HOME/foundry/out
FOUNDRY_STATE_DIR=$HOME/foundry/state
# (No TMPDIR override — the Mac's SSD handles build scratch fine.)

# ---- model engine + credential ----------------------------------------
# Claude Code (`claude -p`) — runs on your Max subscription, no API key/billing.
# Requires the `claude` CLI installed. Auth two ways (pick one): log in on this
# machine (`claude /login` — session cached on disk, auto-refreshes, leave the token
# blank), OR mint a token (`claude setup-token`) and paste it below. Already logged
# in? Leave the token blank — `claude -p` reuses that session.
FOUNDRY_MODEL_BACKEND=claude-cli        # claude-cli | anthropic | openai | codex
FOUNDRY_CODING_ADAPTER=claude-code      # AGENTIC: claude edits/builds/tests in the task
                                        # sandbox (multi-turn). Alternatives: raw-react
                                        # (one completion -> one diff) | stub (no-op)
CLAUDE_CODE_OAUTH_TOKEN=                # optional — PASTE `claude setup-token` OUTPUT, or leave blank if logged in
# Prefer the metered API instead? Comment the token line, set backend=anthropic,
# and use:  ANTHROPIC_API_KEY=sk-ant-...
# (Don't set both a key and a token — the API key outranks and bills the API.)

# ---- model per tier (current Anthropic Claude models, via claude -p) ---
# The factory picks a tier per task; pin the exact model id each maps to.
FOUNDRY_MODEL_T1=claude-opus-4-8        # heaviest reasoning
FOUNDRY_MODEL_T2=claude-sonnet-4-6      # mid / default
FOUNDRY_MODEL_T3=claude-haiku-4-5       # light / cheap

# ---- token efficiency (stretch a Max window further) ------------------
# All optional; apply to BOTH the CLI and the Workshop (env is read the same way).
# Uncomment for a frugal run — quality trade-offs noted:
#   (Prompt caching on the claude-cli path is now ALWAYS ON — no setting. The
#   stable per-role SOP is routed through `claude --append-system-prompt` so
#   repeated prefixes (esp. fix-loop retries) hit Anthropic's cache; verify via
#   the REPO manifest's cache-read tokens. Requires claude >= 1.0.0 for the flag,
#   checked once at startup — upgrade with `npm i -g @anthropic-ai/claude-code`.)
#   Run the recurring review/judge calls on Sonnet instead of Opus (Sonnet is a
#   strong reviewer; this is the biggest recurring saving). Set T1 to restore Opus.
# FOUNDRY_REVIEW_TIER=T2
#   Run the security-review floor (appsec + supply-chain) on Sonnet — fine for a
#   hobby build; leave UNSET (defaults T1) for anything security-sensitive.
# FOUNDRY_SECURITY_TIER=T2

# ---- cost ceiling (only applies to metered API backends) --------------
# Ignored for claude-cli (subscription). Set it if you switch to anthropic/openai.
# FOUNDRY_COST_CAP_MICROUSD=50000000    # $50

# ---- sizing for a 24 GB Mac -------------------------------------------
WORKSHOP_MAX_CONCURRENT_BUILDS=3        # builds at once (extras queue)
FOUNDRY_MAX_SLOTS=4                     # tasks within a build

# ---- gate test sandbox: REQUIRED on macOS -----------------------------
# macOS has no Linux namespace sandbox, so without this EVERY build halts at the
# test gate. This runs generated tests sys.path-fenced — but WITHOUT network
# isolation (they run in your user env). Fine for your own builds; for untrusted
# ones prefer a Linux host (the Pi).
FOUNDRY_GATE_SANDBOX=inprocess

# ---- long-run hardening (safe defaults) -------------------------------
FOUNDRY_CLIENT_TTL_S=3600               # refresh the SDK client hourly
FOUNDRY_MAX_RPM=0                       # set to your plan's req/min only if you hit limits
FOUNDRY_RATE_LIMIT_RETRIES=6            # waits to ride out a 429/529 burst
FOUNDRY_RATE_LIMIT_MAX_WAIT_S=21600     # cap for ONE wait-until-reset (6h) — a spent
                                        # Max window is slept through, not crashed
